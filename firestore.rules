rules_version = '2';

// Maunon ruokinta: kaikki data households/{hid}/... alla.
// Luku ja kirjoitus vain käyttäjille, joiden (vahvistettu) sähköposti on households/{hid}.members-listassa.
// Omistaja voi luoda kotitalouden ja muokata jäsenlistaa.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email.lower() == 'lassi.salminen3@gmail.com';
    }
    function isMember(hid) {
      let path = /databases/$(database)/documents/households/$(hid);
      return signedIn() && exists(path) && request.auth.token.email.lower() in get(path).data.members;
    }

    match /households/{hid} {
      allow read: if isMember(hid) || isOwner();
      allow create, update: if isOwner()
        && request.resource.data.members is list
        && request.auth.token.email.lower() in request.resource.data.members;
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
